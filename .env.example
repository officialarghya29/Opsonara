# Opsonara configuration (copy to .env and adjust)

# Seed 8 realistic demo transactions on boot (nice for the dashboard,
# disable in production)
OPSONARA_SEED_DEMO_DATA=true

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
OPSONARA_LOG_LEVEL=INFO

# Comma-separated CORS origins, or * for any (dev default)
OPSONARA_CORS_ORIGINS=*
